# ── App ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://app.orayn.studio

# ── Supabase (Dashboard → Project Settings → API Keys) ─────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# ── Bachs payments (bachs.io) ──────────────────────────────────────────────
# Use "sandbox" until your Bachs account is approved, then switch to "live"
# and replace the three values below with your LIVE ones.
BACHS_ENV=sandbox
BACHS_API_KEY=your-bachs-secret-api-key
BACHS_WEBHOOK_SECRET=your-bachs-webhook-signing-secret
# ID of the single product you create in the Bachs dashboard ("Orayn Website Build", USD)
BACHS_PRODUCT_ID=your-bachs-product-id
# Optional: only if Bachs gives you a different API address than the default
# BACHS_API_BASE_URL=

# ── Misc ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_DEMO_BASE_URL=https://demo.orayn.studio
NEXT_PUBLIC_WHATSAPP_NUMBER=2348123121554
